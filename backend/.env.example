# Backend secrets (DO NOT COMMIT)
#
# Copy this file to `.env` and fill values.
#
# Google Cloud Speech-to-Text (choose ONE option)
#
# Option A: API key (quick, less ideal)
# GOOGLE_STT_API_KEY=AIzaSy...
#
# Option B: Service Account JSON (recommended)
# Put your JSON file somewhere safe and point to it here:
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\HP\Desktop\AI-SHA\backend\.env\fintech-494209-698c8bdef7f3.json

# Server
PORT=3001

# LLM Provider (AI reply)
# - openai: uses OPENAI_API_KEY + OPENAI_MODEL (default)
# - qwen: uses QWEN_API_KEY + QWEN_MODEL (+ optional QWEN_BASE_URL)
LLM_PROVIDER=openai

# OpenAI (default)
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini

# Qwen (DashScope OpenAI-compatible)
# QWEN_API_KEY=sk-...
QWEN_MODEL=qwen-turbo
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Per-chat savol–javob (faqat berilgan Chat ID uchun): backend/knowledge/conversation_rules.json

